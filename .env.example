# App
APP_NAME=ingeniometrix
NODE_ENV=development
APP_PORT=3301
APP_ORIGIN=http://localhost:3301
LOG_LEVEL=info
NEXT_PUBLIC_SITE_URL=https://ingeniometrix.com
IMX_AUTHLESS_WORKSPACE=0
IMX_SESSION_MAX_AGE_SECONDS=43200

# Database
# The release Compose file maps PostgreSQL to POSTGRES_PORT for local administration.
# DATABASE_URL values below are for direct host-side commands; containers use the db service.
POSTGRES_DB=ingeniometrix
POSTGRES_USER=ingeniometrix
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
POSTGRES_PORT=55436
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# LLM Provider
LLM_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-5.4
LLM_FAST_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
IMX_ENABLE_DEEP_RESEARCH=0

# Research Providers
OPENALEX_API_KEY=
CROSSREF_MAILTO=

# Backend-only user provisioning
ADMIN_USER_EMAIL=
ADMIN_USER_PASSWORD=
ADMIN_USER_NAME=
ADMIN_ASSIGN_ALL_PROJECTS=0

# Deployment smoke checks
SMOKE_USER_EMAIL=
SMOKE_USER_PASSWORD=
VERCEL_AUTOMATION_BYPASS_SECRET=

# Local Paths
IMX_ARTIFACTS_DIR=./artifacts-local
BLUEPRINT_WORKER_SECRET=
BLUEPRINT_WORKER_POLL_MS=2000
BLUEPRINT_MAX_ATTEMPTS=3
BLUEPRINT_STALE_LOCK_MS=600000
BLUEPRINT_HEARTBEAT_MS=30000

# Future Release 0.5 placeholders
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=
