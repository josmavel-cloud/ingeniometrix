generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum ProjectStatus {
  DRAFT
  INTAKE_READY
  SEARCHING
  SOURCES_REVIEW
  SOURCES_SELECTED
  BLUEPRINT_GENERATING
  BLUEPRINT_READY
  EXPORT_READY
  ARCHIVED
}

enum DegreeLevel {
  PREGRADO
  POSGRADO
  ESPECIALIZACION
  MAESTRIA
  DOCTORADO
  PROYECTO_INVESTIGACION
}

enum AcademicFieldResolutionStatus {
  CANONICAL
  CUSTOM_UNRESOLVED
}

enum PlanPublicationStatus {
  PUBLISHED
  SUPERSEDED
}

enum PlanSourceDispositionStatus {
  USED
  CONSIDERED_NOT_USED
  REJECTED_AFTER_INSPECTION
}

enum University {
  PUCP
  UPT
  UNMSM
  UNI
  UP
  UPC
  UPCH
  ULIMA
  UDEP
  USMP
  UCV
  OTHER
}

enum TemplateKey {
  UPC_POSGRADO
  UCV_POSGRADO
  USMP_POSGRADO
  GENERIC_POSGRADO_PE
}

enum TopicOriginType {
  CATALOG
  CUSTOM
  HYBRID
}

enum TopicSelectionStatus {
  PENDING
  SELECTED
}

enum TopicSuggestionSourceType {
  CATALOG
  AI_GENERATED
  USER_SEED
}

enum Provider {
  OPENALEX
  CROSSREF
  OPENAI
  ANTHROPIC
  SYSTEM
}

enum ActorType {
  USER
  SYSTEM
  PROVIDER
}

enum ExportStatus {
  PENDING
  READY
  FAILED
}

enum MvpStepRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PARTIALLY_COMPLETED
}

enum BlueprintJobStatus {
  QUEUED
  RUNNING
  WAITING_NEXT_STAGE
  WAITING_USER_DECISION
  COMPLETED
  FAILED
  CANCELLED
}

enum BlueprintJobStageStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum GeneratedArtifactKind {
  BLUEPRINT_DOCX
  BLUEPRINT_PDF
  BIBTEX
  RIS
  EVIDENCE_LOG
  REPORT_PREVIEW
  SOURCE_PDF
  OTHER
}

enum PeerReviewStatus {
  PEER_REVIEWED
  NOT_PEER_REVIEWED
  UNKNOWN
}

enum PublicationStage {
  PREPRINT
  ACCEPTED_MANUSCRIPT
  VERSION_OF_RECORD
  CORRECTED_VERSION
  RETRACTED
  UNKNOWN
}

enum ClassificationSource {
  PROVIDER
  RULE
  USER
  MODEL
  SYSTEM
}

enum IndexName {
  OPENALEX
  CROSSREF
  DOAJ
  SCOPUS
  WEB_OF_SCIENCE
  LATINDEX
  SCIELO
  REDALYC
  DIALNET
  OTHER
}

enum KeywordSource {
  AUTHOR
  PROVIDER
  USER
  MODEL
  SYSTEM
}

enum TemplateOwnerType {
  SYSTEM
  USER
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TemplateReviewStatus {
  DRAFT
  NEEDS_REVIEW
  REVIEWED
}

enum TemplateSourceType {
  PDF_NATIVE_TEXT
  PDF_IMAGE
  DOCX
  TEXT
  MANUAL
}

enum TemplateDocumentKind {
  THESIS_PLAN_INSTANCE
  TEMPLATE_GUIDE
  THESIS_FINAL_INSTANCE
  UNKNOWN
}

enum TemplateAssetKind {
  LOGO
  SEAL
  COVER_IMAGE
  UNKNOWN
}

enum TemplateAssetSourceStrategy {
  PROVIDED_FILE
  EXTRACTED_FROM_DOCUMENT
  PLACEHOLDER
}

model User {
  id                 String                  @id @default(uuid())
  email              String                  @unique
  passwordHash       String?                 @db.Text
  name               String?
  locale             String                  @default("es-PE")
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  projects           Project[]
  auditLogs          AuditLog[]
  stepRuns           MvpStepRun[]
  templates          Template[]
  sessions           UserSession[]
  blueprintJobs      BlueprintJob[]
  generatedArtifacts GeneratedArtifact[]
  paidOperations     PaidOperation[]
  authIdentities     AuthIdentity[]
  purchases          Purchase[]
  entitlements       CommercialEntitlement[]
  trainingConsent    Boolean                 @default(false)
}

// Pre-generation business spend. Customer credits remain a separate ledger.
model PaidOperation {
  id               String              @id @default(uuid())
  userId           String
  projectId        String?
  draftId          String?
  revision         String
  requestId        String
  purpose          String
  inputFingerprint String
  status           String              @default("RUNNING")
  hardCapMicros    Int
  committedMicros  Int                 @default(0)
  boundBreached    Boolean             @default(false)
  resultJson       Json?
  createdAt        DateTime            @default(now())
  completedAt      DateTime?
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  calls            PaidOperationCall[]

  @@unique([userId, requestId])
  @@index([userId, createdAt])
}

model PaidOperationCall {
  id              String        @id @default(uuid())
  operationId     String
  purpose         String
  model           String
  actualModel     String?
  reservedMicros  Int
  estimatedMicros Int?
  status          String        @default("RESERVED")
  usageJson       Json?
  attributionJson Json
  createdAt       DateTime      @default(now())
  completedAt     DateTime?
  operation       PaidOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId, createdAt])
}

model UserSession {
  id            String    @id @default(uuid())
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  userAgentHash String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model AuthThrottle {
  keyHash         String    @id
  failureCount    Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
}

model AuthIdentity {
  id                      String   @id @default(uuid())
  userId                  String
  provider                String
  providerSubject         String
  emailAtLinkTime         String
  emailVerifiedAtLinkTime Boolean
  createdAt               DateTime @default(now())
  lastUsedAt              DateTime @default(now())
  user                    User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model OidcTransaction {
  stateHash       String    @id
  browserHash     String
  nonce           String
  verifier        String
  redirectUri     String
  linkUserId      String?
  linkSessionHash String?
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())
}

model ProductOffer {
  id        String     @id
  key       String
  version   Int
  snapshot  Json
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  purchases Purchase[]

  @@unique([key, version])
}

model Purchase {
  id                String                 @id @default(uuid())
  userId            String
  offerId           String
  requestKey        String
  snapshot          Json
  termsVersion      String
  privacyVersion    String
  acceptedAt        DateTime
  provider          String
  mode              String
  merchantId        String
  applicationId     String
  status            String                 @default("CREATED")
  providerOrderId   String?                @unique
  checkoutUrl       String?
  providerUpdatedAt DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  user              User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  offer             ProductOffer           @relation(fields: [offerId], references: [id], onDelete: Restrict)
  entitlement       CommercialEntitlement?

  @@unique([userId, requestKey])
}

// One package account keeps plan and compute units separate; balances are locked together.
model CommercialEntitlement {
  id              String                  @id @default(uuid())
  userId          String
  purchaseId      String?                 @unique
  grantKey        String                  @unique
  policy          Json
  grantedSlots    Int
  reservedSlots   Int                     @default(0)
  consumedSlots   Int                     @default(0)
  grantedCredits  Int
  reservedCredits Int                     @default(0)
  consumedCredits Int                     @default(0)
  status          String                  @default("ACTIVE")
  createdAt       DateTime                @default(now())
  user            User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  purchase        Purchase?               @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  reservations    CommercialReservation[]
  entries         CommercialLedgerEntry[]

  @@index([userId, status])
}

model CommercialReservation {
  id                 String                @id @default(uuid())
  jobId              String                @unique
  entitlementId      String
  userId             String
  projectId          String
  inputSnapshotId    String?
  policy             Json
  credits            Int
  chargedCredits     Int                   @default(0)
  status             String                @default("RESERVED")
  blueprintVersionId String?               @unique
  createdAt          DateTime              @default(now())
  settledAt          DateTime?
  job                BlueprintJob          @relation(fields: [jobId], references: [id], onDelete: Restrict)
  entitlement        CommercialEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Restrict)

  @@index([status])
}

// Immutable entries: slot and compute amounts use distinct unit values.
model CommercialLedgerEntry {
  id             String                @id @default(uuid())
  entitlementId  String
  userId         String
  purchaseId     String?
  jobId          String?
  operationKey   String                @unique
  kind           String
  unit           String
  amount         Int
  availableAfter Int
  reason         String
  policyVersion  String
  actor          String
  createdAt      DateTime              @default(now())
  entitlement    CommercialEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

model PaymentEvent {
  id          String    @id
  provider    String
  resourceId  String
  status      String    @default("RECEIVED")
  reason      String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
}

model Project {
  id                        String                         @id @default(uuid())
  userId                    String
  catalogTopicId            String?
  title                     String
  status                    ProjectStatus                  @default(DRAFT)
  country                   String                         @default("PE")
  language                  String                         @default("es")
  degreeLevel               DegreeLevel
  university                University?
  program                   String
  templateKey               TemplateKey                    @default(GENERIC_POSGRADO_PE)
  topicOriginType           TopicOriginType                @default(CATALOG)
  topicSelectionStatus      TopicSelectionStatus           @default(PENDING)
  topicSeedText             String?                        @db.Text
  topicAreaId               String?
  topicAreaLabel            String?                        @db.Text
  selectedTopicSuggestionId String?
  activeBlueprintVersionId  String?                        @unique
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt
  user                      User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  intake                    Intake?
  draft                     ProjectDraft?
  projectReferences         ProjectReference[]
  blueprintVersions         BlueprintVersion[]
  blueprintJobs             BlueprintJob[]
  generatedArtifacts        GeneratedArtifact[]
  auditLogs                 AuditLog[]
  stepRuns                  MvpStepRun[]
  templateContentPlans      ProjectTemplateContentPlan[]
  evidenceLedgers           ProjectEvidenceLedger[]
  evidenceCards             ProjectEvidenceCard[]
  sourceMaterializations    ProjectSourceMaterialization[]
  sourceAssets              ProjectSourceAsset[]
  knowledgeFields           ProjectKnowledgeField[]
  topicSuggestions          ProjectTopicSuggestion[]       @relation("ProjectTopicSuggestions")
  selectedTopicSuggestion   ProjectTopicSuggestion?        @relation("ProjectSelectedTopicSuggestion", fields: [selectedTopicSuggestionId], references: [id], onDelete: SetNull)
  activeBlueprintVersion    BlueprintVersion?              @relation("ProjectActiveBlueprintVersion", fields: [activeBlueprintVersionId], references: [id], onDelete: SetNull)
}

model TopicAreaCatalogEntry {
  id                 String   @id @default(uuid())
  normalizedLabel    String   @unique @db.Text
  displayLabel       String   @db.Text
  canonicalAreaId    String?
  canonicalAreaLabel String?  @db.Text
  usageCount         Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([canonicalAreaId])
}

model Intake {
  id                   String   @id @default(uuid())
  projectId            String   @unique
  topic                String   @db.Text
  problemContext       String?  @db.Text
  researchLine         String?  @db.Text
  academicConstraints  String?  @db.Text
  targetPopulation     String?  @db.Text
  availableData        String?  @db.Text
  preferredMethodology String?  @db.Text
  advisorNotes         String?  @db.Text
  researchScope        String?  @db.Text
  constructs           String?  @db.Text
  pendingDecisions     String?  @db.Text
  searchQuery          String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Mutable workspace state. Generations consume immutable input snapshots, not this row.
model ProjectDraft {
  id                String    @id @default(uuid())
  projectId         String    @unique
  revision          Int       @default(1)
  confirmedRevision Int?
  contentJson       Json
  contentHash       String
  staleScopesJson   Json      @default("[]")
  lastInvalidatedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Reference {
  id               String                     @id @default(uuid())
  doi              String?
  openAlexId       String?                    @unique
  crossrefId       String?
  title            String                     @db.Text
  normalizedTitle  String                     @db.Text
  authorsJson      Json
  abstract         String?                    @db.Text
  venue            String?
  year             Int?
  workType         String?
  landingPageUrl   String?                    @db.Text
  citationCount    Int?
  rawOpenAlexJson  Json?
  rawCrossrefJson  Json?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  projectLinks     ProjectReference[]
  classification   ReferenceClassification?
  indexMemberships ReferenceIndexMembership[]
  keywords         ReferenceKeyword[]

  @@index([doi])
  @@index([normalizedTitle, year])
}

model ProjectReference {
  id               String                  @id @default(uuid())
  projectId        String
  referenceId      String
  sourceProvider   Provider
  relevanceScore   Float?
  selected         Boolean                 @default(false)
  selectedOrder    Int?
  selectionReason  String?                 @db.Text
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  project          Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reference        Reference               @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  planDispositions PlanSourceDisposition[]

  @@unique([projectId, referenceId])
  @@index([projectId, relevanceScore])
  @@index([projectId, selected, selectedOrder])
}

model BlueprintVersion {
  id                             String                   @id @default(uuid())
  projectId                      String
  versionNumber                  Int
  model                          String
  promptVersion                  String
  intakeSnapshotJson             Json
  selectedReferencesSnapshotJson Json
  blueprintJson                  Json
  coherenceReportJson            Json
  exportStatus                   ExportStatus             @default(PENDING)
  publicationStatus              PlanPublicationStatus    @default(PUBLISHED)
  originatingDraftRevision       Int?
  generationJobId                String?                  @unique
  generationInputSnapshotId      String?                  @unique
  userLabel                      String?                  @db.Text
  generationManifestJson         Json?
  createdAt                      DateTime                 @default(now())
  project                        Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activeForProject               Project?                 @relation("ProjectActiveBlueprintVersion")
  generationJob                  BlueprintJob?            @relation(fields: [generationJobId], references: [id], onDelete: SetNull)
  generationInputSnapshot        GenerationInputSnapshot? @relation(fields: [generationInputSnapshotId], references: [id], onDelete: SetNull)
  generatedArtifacts             GeneratedArtifact[]
  sourceDispositions             PlanSourceDisposition[]

  @@unique([projectId, versionNumber])
}

model BlueprintJob {
  id                    String                    @id @default(uuid())
  projectId             String
  userId                String
  status                BlueprintJobStatus        @default(QUEUED)
  currentStage          String?
  progress              Int                       @default(0)
  language              String                    @default("es")
  runnerKind            String                    @default("database-worker")
  attempts              Int                       @default(0)
  maxAttempts           Int                       @default(3)
  nextAttemptAt         DateTime?
  lockedAt              DateTime?
  lastHeartbeatAt       DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  errorMessage          String?                   @db.Text
  errorJson             Json?
  metadataJson          Json?
  stageDataJson         Json?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  project               Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stages                BlueprintJobStage[]
  inputSnapshots        GenerationInputSnapshot[]
  generatedArtifacts    GeneratedArtifact[]
  blueprintVersion      BlueprintVersion?
  commercialReservation CommercialReservation?

  @@index([projectId, status])
  @@index([userId, status])
  @@index([status, nextAttemptAt, updatedAt])
}

model BlueprintJobStage {
  id          String                  @id @default(uuid())
  jobId       String
  stageKey    String
  status      BlueprintJobStageStatus @default(QUEUED)
  progress    Int
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?
  inputJson   Json?
  outputJson  Json?
  errorJson   Json?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  job         BlueprintJob            @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, stageKey])
  @@index([jobId, status])
}

// Append-only inputs; revisions never overwrite what a previous plan consumed.
model GenerationInputSnapshot {
  id               String            @id @default(uuid())
  jobId            String
  revision         Int
  draftId          String?
  draftRevision    Int?
  contentHash      String
  payloadJson      Json
  createdAt        DateTime          @default(now())
  job              BlueprintJob      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  blueprintVersion BlueprintVersion?

  @@unique([jobId, revision])
}

model GeneratedArtifact {
  id                 String                @id @default(uuid())
  userId             String
  projectId          String
  blueprintVersionId String?
  jobId              String?
  kind               GeneratedArtifactKind
  fileName           String
  mimeType           String
  byteSize           Int
  sha256             String
  content            Bytes
  metadataJson       Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  project            Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  blueprintVersion   BlueprintVersion?     @relation(fields: [blueprintVersionId], references: [id], onDelete: Cascade)
  job                BlueprintJob?         @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@unique([blueprintVersionId, kind, fileName])
  @@index([projectId, kind, createdAt])
  @@index([userId, kind, createdAt])
  @@index([jobId, kind])
  @@index([sha256])
}

model AuditLog {
  id          String    @id @default(uuid())
  projectId   String?
  userId      String?
  eventType   String
  actorType   ActorType
  provider    Provider?
  payloadJson Json
  createdAt   DateTime  @default(now())
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
}

model MvpStepRun {
  id                     String                         @id @default(uuid())
  projectId              String
  userId                 String?
  stepKey                String
  status                 MvpStepRunStatus               @default(PENDING)
  provider               Provider?
  model                  String?
  promptVersion          String?
  startedAt              DateTime                       @default(now())
  finishedAt             DateTime?
  durationMs             Int?
  retryCount             Int                            @default(0)
  fallbackUsed           Boolean                        @default(false)
  inputHash              String?
  outputHash             String?
  inputSnapshotJson      Json?
  outputSnapshotJson     Json?
  warningsJson           Json?
  errorsJson             Json?
  artifactDir            String?                        @db.Text
  artifactManifestPath   String?                        @db.Text
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  project                Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                   User?                          @relation(fields: [userId], references: [id], onDelete: SetNull)
  templateContentPlans   ProjectTemplateContentPlan[]
  evidenceLedgers        ProjectEvidenceLedger[]
  evidenceCards          ProjectEvidenceCard[]
  sourceMaterializations ProjectSourceMaterialization[]
  sourceAssets           ProjectSourceAsset[]

  @@index([projectId, stepKey, startedAt])
  @@index([projectId, status, startedAt])
  @@index([inputHash])
  @@index([promptVersion, model])
}

model ProjectTemplateContentPlan {
  id                   String     @id @default(uuid())
  projectId            String
  stepRunId            String
  templateVersionId    String?
  templateKey          String
  citationStyle        String
  qualityStatus        String     @default("PLANNED")
  sectionPlanJson      Json
  llmWavePlanJson      Json
  artifactManifestPath String?    @db.Text
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  project              Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepRun              MvpStepRun @relation(fields: [stepRunId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([stepRunId])
  @@index([templateKey, citationStyle])
}

model ProjectEvidenceLedger {
  id                     String                         @id @default(uuid())
  projectId              String
  stepRunId              String
  citationStyle          String
  sourceRegistryJson     Json
  referencesJson         Json
  ledgerJson             Json
  artifactManifestPath   String?                        @db.Text
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  project                Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepRun                MvpStepRun                     @relation(fields: [stepRunId], references: [id], onDelete: Cascade)
  evidenceCards          ProjectEvidenceCard[]
  sourceMaterializations ProjectSourceMaterialization[]
  sourceAssets           ProjectSourceAsset[]

  @@index([projectId, createdAt])
  @@index([stepRunId])
  @@index([citationStyle])
}

model ProjectEvidenceCard {
  id               String                 @id @default(uuid())
  projectId        String
  stepRunId        String
  evidenceLedgerId String?
  sourceId         String
  referenceId      String
  citationKey      String
  evidenceBasis    String
  qualityStatus    String                 @default("NEEDS_REVIEW")
  qualityScore     Float?
  requiresFullText Boolean                @default(true)
  sectionKeysJson  Json
  contentJson      Json
  artifactPath     String?                @db.Text
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepRun          MvpStepRun             @relation(fields: [stepRunId], references: [id], onDelete: Cascade)
  evidenceLedger   ProjectEvidenceLedger? @relation(fields: [evidenceLedgerId], references: [id], onDelete: Cascade)

  @@index([projectId, sourceId])
  @@index([projectId, referenceId])
  @@index([projectId, qualityStatus])
  @@index([stepRunId])
  @@index([evidenceLedgerId])
}

model ProjectSourceMaterialization {
  id                  String                 @id @default(uuid())
  projectId           String
  stepRunId           String
  evidenceLedgerId    String?
  sourceId            String
  referenceId         String
  materializationType String
  status              String
  sourcePdfPath       String?                @db.Text
  fulltextPath        String?                @db.Text
  pagesPath           String?                @db.Text
  chunksPath          String?                @db.Text
  metricsJson         Json
  artifactsJson       Json
  errorsJson          Json?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  project             Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepRun             MvpStepRun             @relation(fields: [stepRunId], references: [id], onDelete: Cascade)
  evidenceLedger      ProjectEvidenceLedger? @relation(fields: [evidenceLedgerId], references: [id], onDelete: Cascade)

  @@index([projectId, sourceId])
  @@index([projectId, referenceId])
  @@index([projectId, status])
  @@index([stepRunId])
  @@index([evidenceLedgerId])
}

model ProjectSourceAsset {
  id               String                 @id @default(uuid())
  projectId        String
  stepRunId        String
  evidenceLedgerId String?
  sourceId         String
  referenceId      String
  citationKey      String
  assetKind        String
  status           String
  curationStatus   String                 @default("RAW")
  curationScore    Float?
  sectionKey       String?
  pageNumber       Int?
  imagePath        String?                @db.Text
  structuredPath   String?                @db.Text
  bboxJson         Json?
  metadataJson     Json
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepRun          MvpStepRun             @relation(fields: [stepRunId], references: [id], onDelete: Cascade)
  evidenceLedger   ProjectEvidenceLedger? @relation(fields: [evidenceLedgerId], references: [id], onDelete: Cascade)

  @@index([projectId, sourceId])
  @@index([projectId, referenceId])
  @@index([projectId, assetKind])
  @@index([projectId, curationStatus])
  @@index([projectId, sectionKey])
  @@index([projectId, status])
  @@index([stepRunId])
  @@index([evidenceLedgerId])
}

model TaxonomyScheme {
  id           String            @id @default(uuid())
  code         String            @unique
  name         String
  version      String?
  uri          String?
  description  String?           @db.Text
  sourceJson   Json?
  isActive     Boolean           @default(true)
  deprecatedAt DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  concepts     TaxonomyConcept[]
}

model TaxonomyConcept {
  id                          String                    @id @default(uuid())
  schemeId                    String
  parentId                    String?
  conceptCode                 String
  conceptUri                  String?
  prefLabel                   String
  altLabelsJson               Json?
  labelOriginal               String?
  labelEs                     String?
  normalizedSearchText        String?                   @db.Text
  definition                  String?                   @db.Text
  lang                        String                    @default("es")
  sourceJson                  Json?
  isActive                    Boolean                   @default(true)
  deprecatedAt                DateTime?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  scheme                      TaxonomyScheme            @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  parent                      TaxonomyConcept?          @relation("TaxonomyConceptTree", fields: [parentId], references: [id], onDelete: SetNull)
  children                    TaxonomyConcept[]         @relation("TaxonomyConceptTree")
  projectKnowledgeFields      ProjectKnowledgeField[]
  resourceTypeClassifications ReferenceClassification[]
  referenceKeywords           ReferenceKeyword[]
  primaryTopicSuggestions     ProjectTopicSuggestion[]  @relation("TopicSuggestionPrimaryConcept")

  @@unique([schemeId, conceptCode])
  @@index([schemeId, isActive])
}

model ProjectKnowledgeField {
  id                       String                        @id @default(uuid())
  projectId                String
  conceptId                String?
  isPrimary                Boolean                       @default(false)
  source                   ClassificationSource
  resolutionStatus         AcademicFieldResolutionStatus @default(CANONICAL)
  submittedLabel           String?                       @db.Text
  normalizedSubmittedLabel String?                       @db.Text
  customLabel              String?                       @db.Text
  matchedAlias             String?                       @db.Text
  taxonomyCodeSnapshot     String?
  taxonomyVersionSnapshot  String?
  confidence               Float?
  evidenceJson             Json?
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  project                  Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  concept                  TaxonomyConcept?              @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  @@unique([projectId, conceptId])
  @@index([projectId, isPrimary])
  @@index([projectId, resolutionStatus])
  @@index([normalizedSubmittedLabel])
}

model PlanSourceDisposition {
  id                      String                      @id @default(uuid())
  blueprintVersionId      String
  projectReferenceId      String
  status                  PlanSourceDispositionStatus
  reason                  String?                     @db.Text
  evidenceLevel           String?
  relevanceDimensionsJson Json?
  provenanceJson          Json?
  createdAt               DateTime                    @default(now())
  blueprintVersion        BlueprintVersion            @relation(fields: [blueprintVersionId], references: [id], onDelete: Cascade)
  projectReference        ProjectReference            @relation(fields: [projectReferenceId], references: [id], onDelete: Cascade)

  @@unique([blueprintVersionId, projectReferenceId])
  @@index([blueprintVersionId, status])
  @@index([projectReferenceId])
}

model ProjectTopicSuggestion {
  id                 String                    @id @default(uuid())
  projectId          String
  sourceType         TopicSuggestionSourceType
  catalogTopicId     String?
  seedText           String?                   @db.Text
  title              String                    @db.Text
  researchLine       String?                   @db.Text
  rationale          String?                   @db.Text
  metadataJson       Json?
  primaryConceptId   String?
  selected           Boolean                   @default(false)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  project            Project                   @relation("ProjectTopicSuggestions", fields: [projectId], references: [id], onDelete: Cascade)
  primaryConcept     TaxonomyConcept?          @relation("TopicSuggestionPrimaryConcept", fields: [primaryConceptId], references: [id], onDelete: SetNull)
  selectedByProjects Project[]                 @relation("ProjectSelectedTopicSuggestion")

  @@unique([projectId, sourceType, title])
  @@index([projectId, selected])
  @@index([primaryConceptId])
}

model ReferenceClassification {
  id                    String               @id @default(uuid())
  referenceId           String               @unique
  resourceTypeGeneral   String?
  resourceTypeSpecific  String?
  resourceTypeConceptId String?
  peerReviewStatus      PeerReviewStatus     @default(UNKNOWN)
  publicationStage      PublicationStage     @default(UNKNOWN)
  doiInteropType        String?
  source                ClassificationSource
  confidence            Float?
  evidenceJson          Json?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  reference             Reference            @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  resourceTypeConcept   TaxonomyConcept?     @relation(fields: [resourceTypeConceptId], references: [id], onDelete: SetNull)
}

model ReferenceIndexMembership {
  id           String               @id @default(uuid())
  referenceId  String
  indexName    IndexName
  indexLabel   String?
  source       ClassificationSource
  status       String
  evidenceJson Json?
  checkedAt    DateTime             @default(now())
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  reference    Reference            @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@unique([referenceId, indexName])
}

model ReferenceKeyword {
  id                String           @id @default(uuid())
  referenceId       String
  keywordText       String
  normalizedKeyword String
  conceptId         String?
  source            KeywordSource
  score             Float?
  isValidated       Boolean          @default(false)
  evidenceJson      Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  reference         Reference        @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  concept           TaxonomyConcept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  @@index([referenceId, normalizedKeyword])
}

model Template {
  id             String            @id @default(uuid())
  key            String            @unique
  name           String
  ownerType      TemplateOwnerType
  ownerUserId    String?
  status         TemplateStatus    @default(DRAFT)
  universityName String?
  schoolName     String?
  programName    String?
  mention        String?
  degreeLevel    String?
  disciplineArea String?
  templateFamily String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  ownerUser      User?             @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  versions       TemplateVersion[]

  @@index([ownerType, status])
  @@index([universityName, degreeLevel, status])
}

model TemplateVersion {
  id                     String               @id @default(uuid())
  templateId             String
  versionNumber          Int
  schemaVersion          String
  language               String
  methodologyMode        String?
  citationStyle          String?
  documentKind           TemplateDocumentKind @default(UNKNOWN)
  reviewStatus           TemplateReviewStatus @default(NEEDS_REVIEW)
  templateFamily         String?
  templateKeyGuess       String?
  universityName         String?
  schoolName             String?
  programName            String?
  mention                String?
  degreeLevel            String?
  disciplineArea         String?
  normalizedDocumentJson Json
  semanticAnalysisJson   Json?
  templateCandidateJson  Json
  createdAt              DateTime             @default(now())
  template               Template             @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sources                TemplateSource[]
  assets                 TemplateAsset[]

  @@unique([templateId, versionNumber])
  @@index([documentKind, reviewStatus, methodologyMode])
  @@index([universityName, degreeLevel, citationStyle])
}

model TemplateSource {
  id                String               @id @default(uuid())
  templateVersionId String
  sourceId          String
  sourceType        TemplateSourceType
  documentKind      TemplateDocumentKind
  originalFilePath  String?              @db.Text
  storedFilePath    String?              @db.Text
  fileName          String?
  mimeType          String?
  fileHash          String?
  fileData          Bytes?
  metadataJson      Json?
  createdAt         DateTime             @default(now())
  templateVersion   TemplateVersion      @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)

  @@index([templateVersionId, sourceType])
}

model TemplateAsset {
  id                String                      @id @default(uuid())
  templateVersionId String
  assetKey          String
  kind              TemplateAssetKind
  sourceStrategy    TemplateAssetSourceStrategy
  originalFilePath  String?                     @db.Text
  storedFilePath    String?                     @db.Text
  fileName          String?
  mimeType          String?
  fileHash          String?
  fileData          Bytes?
  widthPx           Int?
  heightPx          Int?
  hasTransparency   Boolean?
  metadataJson      Json?
  createdAt         DateTime                    @default(now())
  templateVersion   TemplateVersion             @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)

  @@unique([templateVersionId, assetKey])
}
