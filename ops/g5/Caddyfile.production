{
  admin off
  auto_https off
  servers {
    timeouts {
      read_header 10s
      read_body 120s
      write 180s
      idle 60s
    }
  }
}
:8080 {
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
    Cache-Control "private, no-store"
    -Server
  }
  log {
    output stdout
    format filter {
      wrap json
      fields {
        request>uri delete
        request>headers delete
        resp_headers delete
      }
    }
  }
  @productionHost host api.ingeniometrix.com
  route {
    handle @productionHost {
      @health path /api/health/live /api/health/ready /api/health/operational
      @private path /api/internal/* /api/labs/* /api/blueprint-launch/* /api/health/*
      @upload path /api/transfers/upload
      handle @health {
        reverse_proxy app:3000
      }
      respond @private 404
      handle @upload {
        request_body {
          max_size 31457280
        }
        reverse_proxy app:3000
      }
      handle /api/* {
        request_body {
          max_size 1MB
        }
        reverse_proxy app:3000
      }
      respond 404
    }
    respond 404
  }
}
